`timescale 1ns/1ps
module testbench;
    parameter DATA_WIDTH = 8;
    parameter ADDR_WIDTH = 4;
    parameter DEPTH = 1 << ADDR_WIDTH;
    logic wr_clk = 0, rd_clk = 0, rst_n = 0;
    logic wr_en = 0, rd_en = 0;
    logic [DATA_WIDTH-1:0] data_in = 0, data_out;
    logic full, empty;
    integer i, errors = 0;

    async_fifo #(.DATA_WIDTH(DATA_WIDTH),
                 .ADDR_WIDTH(ADDR_WIDTH)) dut (
        .wr_clk(wr_clk), .rd_clk(rd_clk), .rst_n(rst_n),
        .wr_en(wr_en), .rd_en(rd_en), .data_in(data_in),
        .data_out(data_out), .full(full), .empty(empty)
    );

    always #5 wr_clk = ~wr_clk; // 10 ns write clock
    always #7 rd_clk = ~rd_clk; // 14 ns read clock

    initial begin
        $dumpfile("dump.vcd");
        $dumpvars(0, testbench);
        $display("ASYNCHRONOUS FIFO TEST STARTED");

        // Reset test
        rst_n = 0;
        repeat(4) @(posedge wr_clk);
        rst_n = 1;
        repeat(4) @(posedge rd_clk);
        if (empty == 1 && full == 0)
            $display("RESET TEST PASSED");
        else begin
            $display("RESET TEST FAILED"); errors++;
        end

        // Write 16 values: 10 through 25
        for (i=0; i<DEPTH; i=i+1) begin
            @(negedge wr_clk); wr_en=1; data_in=i+10;
            @(negedge wr_clk); wr_en=0;
        end
        repeat(4) @(posedge wr_clk);
        if (full == 1) $display("FULL TEST PASSED");
        else begin $display("FULL TEST FAILED"); errors++; end

        // Read and compare values in FIFO order
        for (i=0; i<DEPTH; i=i+1) begin
            wait(empty == 0);
            @(negedge rd_clk); rd_en=1;
            @(posedge rd_clk); #1;
            if (data_out == i+10)
                $display("READ DATA PASSED: %0d", data_out);
            else begin
                $display("READ DATA FAILED: Expected %0d, Got %0d",
                         i+10, data_out);
                errors++;
            end
            @(negedge rd_clk); rd_en=0;
        end

        repeat(4) @(posedge rd_clk);
        if (empty == 1) $display("EMPTY TEST PASSED");
        else begin $display("EMPTY TEST FAILED"); errors++; end

        if (errors == 0) $display("ALL TESTS PASSED");
        else $display("TESTS FAILED: %0d errors", errors);
        $finish;
    end
endmodule
